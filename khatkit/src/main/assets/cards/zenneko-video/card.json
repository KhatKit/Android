{
  "name": "zenneko_video",
  "version": "1.0.0",
  "description": "视频聚合搜索：腾讯/爱奇艺/优酷/芒果/乐视聚合搜索、选集、播放链接解析与弹幕；仅 play 成功解析出播放链接扣费 ¥0.02/次",
  "author": "khatkit",
  "license": "MIT",
  "engine": "lua",
  "entry": { "lua": "main.lua" },
  "privilege": "none",
  "requires": {
    "bridges": ["tool", "ui", "store"],
    "libs": [],
    "bins": [],
    "env": []
  },
  "network": { "allow": ["zenneko.top"] },
  "parameters": {
    "type": "object",
    "properties": {
      "action": { "type": "string", "enum": ["search", "episodes", "play", "danmaku", "danmaku_send"], "description": "操作：search（搜索）/ episodes（选集）/ play（解析播放，成功扣费）/ danmaku（弹幕）/ danmaku_send（发弹幕）" },
      "keyword": { "type": "string", "description": "search 时使用：搜索关键词，如「斗罗大陆」" },
      "site": { "type": "string", "enum": ["tencent", "iqiyi", "youku", "mgtv", "letv", "all"], "description": "站点，默认 all" },
      "page": { "type": "integer", "description": "页码，默认 1" },
      "url": { "type": "string", "description": "episodes / play / danmaku 时的播放页 URL" },
      "vid": { "type": "string", "description": "视频 ID（可选，与 cid、site 组合替代 url）" },
      "cid": { "type": "string", "description": "专辑/频道 ID（腾讯 / 芒果）" },
      "dmid": { "type": "string", "description": "弹幕池 ID（play 返回）；danmaku 时传入则合并云端弹幕" },
      "text": { "type": "string", "description": "danmaku_send 时的弹幕内容" },
      "time": { "type": "number", "description": "弹幕时间点（秒），默认 0" },
      "color": { "type": "string", "description": "弹幕颜色，默认 #ffffff" },
      "type": { "type": "string", "enum": ["right", "top", "bottom"], "description": "弹幕类型，默认 right" },
      "size": { "type": "string", "description": "弹幕字号，默认 32px" }
    },
    "required": ["action"]
  },
  "ui": {
    "action": { "source": "ui", "widget": "select" },
    "keyword": { "source": "ui", "widget": "input" },
    "url": { "source": "ui", "widget": "input" }
  },
  "tags": { "domain": "media", "action": "read", "scene": "daily" },
  "compliance": { "risk": "medium", "note": "付费接口：仅 action=play 且成功解析出播放链接时扣费 ¥0.02（失败不扣费）；请遵守视频平台版权规定，仅用于个人学习" },
  "store": { "quota_mb": 1, "secret": true }
}
