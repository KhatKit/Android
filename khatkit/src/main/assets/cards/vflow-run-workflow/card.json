{
  "name": "vflow_run_workflow",
  "version": "1.0.0",
  "description": "执行本机 vFlow 里的工作流（按 ID 或名字，返回执行结果）",
  "author": "khatkit",
  "license": "MIT",
  "engine": "lua",
  "entry": { "lua": "main.lua" },
  "privilege": "none",
  "requires": {
    "bridges": ["tool", "ui", "store"],
    "libs": [],
    "bins": [],
    "env": []
  },
  "network": { "allow": ["127.0.0.1", "localhost"] },
  "parameters": {
    "type": "object",
    "properties": {
      "workflow_id": { "type": "string", "description": "工作流 UUID（与 name 二选一）" },
      "name": { "type": "string", "description": "工作流名字（模糊匹配，与 workflow_id 二选一）" },
      "variables": { "type": "string", "description": "可选的 inputVariables JSON 字符串" }
    },
    "required": []
  },
  "tags": { "domain": "device", "action": "control", "scene": "daily" },
  "compliance": { "risk": "low", "note": "" },
  "store": { "quota_mb": 1, "secret": true }
}
