{
  "name": "local_image_toolbox",
  "version": "1.0.0",
  "description": "本地图像工具箱：在设备上完成缩放/裁剪/旋转/翻转/灰度/模糊/锐化/像素化/亮度对比度/饱和度/色相/自动对比度/反色/复古/水印/边框/圆角/格式转换/压缩/清除元数据，以及图片转 PDF / PDF 转图片/页数读取。全程离线处理、不上传云端，结果写到源文件同目录（或指定输出路径）",
  "author": "khatkit",
  "license": "MIT",
  "engine": "lua",
  "entry": { "lua": "main.lua" },
  "privilege": "none",
  "requires": {
    "bridges": ["tool", "ui", "imageToolbox"],
    "libs": [],
    "bins": [],
    "env": []
  },
  "network": { "allow": [] },
  "parameters": {
    "type": "object",
    "properties": {
      "op": {
        "type": "string",
        "enum": [
          "resize", "crop", "rotate", "flip", "grayscale", "blur", "sharpen", "pixelate",
          "brightness_contrast", "saturation", "hue", "auto_contrast", "invert", "sepia",
          "watermark", "border", "round_corners", "format_convert", "compress", "strip_metadata",
          "images_to_pdf", "pdf_to_images", "pdf_page_count"
        ],
        "description": "操作名（默认 resize）"
      },
      "image": { "type": "string", "description": "源图片/PDF 本地路径（多张可用 files 或换行/逗号分隔）" },
      "files": {
        "type": "array",
        "items": { "type": "string" },
        "description": "批量图片路径；images_to_pdf 时按数组顺序成页"
      },
      "output": { "type": "string", "description": "显式输出路径；pdf_to_images 时为输出目录，缺省与源同目录" },
      "params": { "type": "string", "description": "操作参数 JSON 字符串，如 {\"width\":800,\"keep_aspect\":true}" }
    },
    "required": ["op"]
  },
  "ui": {
    "image": { "source": "ui", "widget": "file_picker" },
    "op": { "source": "ui", "widget": "select" },
    "params": { "source": "ui", "widget": "input" }
  },
  "triggers": ["ai", "user"],
  "tags": { "domain": "media", "action": "create", "scene": "daily" },
  "compliance": {
    "risk": "low",
    "note": "全部处理在本机完成，不上传任何图片；输出文件写在源图同目录"
  },
  "store": { "quota_mb": 8, "secret": false }
}
