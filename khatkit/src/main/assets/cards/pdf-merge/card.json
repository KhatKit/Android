{
  "name": "pdf_merge",
  "version": "1.0.0",
  "description": "合并多个 PDF 为一个",
  "author": "khatkit",
  "license": "MIT",
  "engine": "lua",
  "entry": { "lua": "main.lua" },
  "privilege": "none",
  "requires": {
    "bridges": ["tool", "ui"],
    "libs": [],
    "bins": [],
    "env": []
  },
  "network": { "allow": [] },
  "parameters": {
    "type": "object",
    "properties": {
      "paths": {
        "type": "array",
        "items": { "type": "string" },
        "description": "待合并的 PDF 路径"
      }
    },
    "required": ["paths"]
  },
  "ui": {
    "paths": { "source": "ui", "widget": "file_picker", "filter": "application/pdf" }
  },
  "tags": { "domain": "file", "action": "convert", "scene": "work" },
  "compliance": { "risk": "low", "note": "" },
  "store": { "quota_mb": 50, "secret": false }
}
