{
  "name": "cloud_image_toolbox",
  "version": "1.0.0",
  "description": "云端图像工具箱：调用 KodeHead Hub 完成缩放/裁剪/旋转/翻转/灰度/模糊/锐化/像素化/亮度对比度/饱和度/色相/自动对比度/反色/复古/水印/边框/圆角/格式转换/压缩等 20 项处理，结果保存到下载目录（全部免费，不扣任何额度）",
  "author": "khatkit",
  "license": "MIT",
  "engine": "lua",
  "entry": { "lua": "main.lua" },
  "privilege": "none",
  "requires": {
    "bridges": ["tool", "ui", "store"],
    "libs": [],
    "bins": [],
    "env": []
  },
  "network": { "allow": ["heizige.top"] },
  "parameters": {
    "type": "object",
    "properties": {
      "image": { "type": "string", "description": "待处理图片的本地路径" },
      "files": { "type": "array", "items": { "type": "string" }, "description": "批量处理的图片路径列表（最多 20 张）" },
      "op": { "type": "string", "description": "操作名：resize/crop/rotate/flip/grayscale/blur/sharpen/pixelate/brightness_contrast/saturation/hue/auto_contrast/invert/sepia/watermark/border/round_corners/format_convert/compress/strip_metadata" },
      "params": { "type": "object", "description": "操作参数对象，如 {\"width\":800}；也可传 JSON 字符串" },
      "format": { "type": "string", "description": "输出格式 png/jpg/bmp/gif，默认 png（compress 默认 jpg）" },
      "quality": { "type": "integer", "description": "JPEG 质量 1..100" },
      "token": { "type": "string", "description": "Hub 激活令牌（留空则读取已保存的 hub_token）" },
      "hub": { "type": "string", "description": "Hub 地址，默认 https://heizige.top" }
    },
    "required": []
  },
  "ui": {
    "image": { "source": "ui", "widget": "file_picker" },
    "files": { "source": "ui", "widget": "file_picker" },
    "op": { "source": "ui", "widget": "select" },
    "params": { "source": "ui", "widget": "input" },
    "format": { "source": "ui", "widget": "select" },
    "quality": { "source": "ui", "widget": "slider", "min": 1, "max": 100 },
    "token": { "source": "ui", "widget": "input" }
  },
  "triggers": ["ai", "user"],
  "tags": { "domain": "media", "action": "convert", "scene": "daily" },
  "compliance": {
    "risk": "medium",
    "note": "图片会上传到配置的 Hub 服务器处理；全部免费，不扣工具调用额度；请勿上传敏感或未授权图片"
  },
  "store": { "quota_mb": 8, "secret": true }
}
