{
  "name": "zenneko_removeobject",
  "version": "1.0.0",
  "description": "移除对象：根据 mask 擦除图片中的指定区域并智能修复（成功扣费 ¥0.02/次）",
  "author": "khatkit",
  "license": "MIT",
  "engine": "lua",
  "entry": { "lua": "main.lua" },
  "privilege": "none",
  "requires": {
    "bridges": ["tool", "ui", "store"],
    "libs": [],
    "bins": [],
    "env": []
  },
  "network": { "allow": ["zenneko.top"] },
  "parameters": {
    "type": "object",
    "properties": {
      "image": { "type": "string", "description": "原图本地路径（也可直接传 data URL / base64）" },
      "mask": { "type": "string", "description": "遮罩图本地路径（待移除区域，白色为移除；也可传 data URL / base64）" }
    },
    "required": ["image", "mask"]
  },
  "ui": {
    "image": { "source": "ui", "widget": "file_picker" },
    "mask": { "source": "ui", "widget": "file_picker" }
  },
  "tags": { "domain": "media", "action": "clean", "scene": "daily" },
  "compliance": { "risk": "medium", "note": "付费接口：成功调用扣费 ¥0.02/次（失败不扣费）；请确保拥有图片使用授权" },
  "store": { "quota_mb": 1, "secret": true }
}
