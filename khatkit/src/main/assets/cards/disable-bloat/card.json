{
  "name": "disable_bloat",
  "version": "1.0.0",
  "description": "通过 Shizuku/root 禁用或启用预装应用（command 形态示例）",
  "author": "khatkit",
  "license": "MIT",
  "engine": "command",
  "command": "pm disable {pkg}",
  "privilege": "elevated",
  "requires": {
    "bridges": ["shizuku"],
    "libs": [],
    "bins": [],
    "env": []
  },
  "network": { "allow": [] },
  "parameters": {
    "type": "object",
    "properties": {
      "pkg": { "type": "string", "description": "要禁用的包名，例如 com.example.bloat" }
    },
    "required": ["pkg"]
  },
  "tags": { "domain": "app", "action": "control", "scene": "privacy" },
  "compliance": {
    "risk": "medium",
    "note": "禁用系统应用可能导致功能异常或无法开机，请自行确认风险"
  },
  "store": { "quota_mb": 1, "secret": false }
}
