{
  "name": "zenneko_aggregate",
  "version": "1.0.0",
  "description": "聚合解析：短视频/图文链接聚合解析，获取无水印资源；getChannels 免费，parse 成功扣费 ¥0.02/次",
  "author": "khatkit",
  "license": "MIT",
  "engine": "lua",
  "entry": { "lua": "main.lua" },
  "privilege": "none",
  "requires": {
    "bridges": ["tool", "ui", "store"],
    "libs": [],
    "bins": [],
    "env": []
  },
  "network": { "allow": ["zenneko.top"] },
  "parameters": {
    "type": "object",
    "properties": {
      "action": { "type": "string", "enum": ["getChannels", "parse"], "description": "getChannels（免费获取渠道列表）/ parse（解析，成功扣费）" },
      "channel": { "type": "string", "description": "parse 必填：渠道 ID（如 dwo / yuafeng，来自 getChannels）" },
      "url": { "type": "string", "description": "parse 必填：待解析的短视频/图文链接" }
    },
    "required": ["action"]
  },
  "ui": {
    "action": { "source": "ui", "widget": "select" },
    "channel": { "source": "ui", "widget": "input" },
    "url": { "source": "ui", "widget": "input" }
  },
  "tags": { "domain": "media", "action": "read", "scene": "daily" },
  "compliance": { "risk": "medium", "note": "付费接口：parse 成功扣费 ¥0.02/次（失败不扣费）；请遵守平台版权规定，仅用于个人学习" },
  "store": { "quota_mb": 1, "secret": true }
}
