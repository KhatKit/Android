{
  "name": "zenneko_caipu",
  "version": "1.0.0",
  "description": "菜谱大全：排行榜（rank）/ 关键词搜索（search）/ 详情（detail，含配料、步骤、技巧）（免费）",
  "author": "khatkit",
  "license": "MIT",
  "engine": "lua",
  "entry": { "lua": "main.lua" },
  "privilege": "none",
  "requires": {
    "bridges": ["tool", "ui", "store"],
    "libs": [],
    "bins": [],
    "env": []
  },
  "network": { "allow": ["zenneko.top"] },
  "parameters": {
    "type": "object",
    "properties": {
      "type": { "type": "string", "enum": ["rank", "search", "detail"], "description": "rank（排行榜）/ search（搜索）/ detail（详情）" },
      "rankType": { "type": "string", "description": "rank 时使用：dayclick / weekclick / monthclick" },
      "keyword": { "type": "string", "description": "search 时的关键词，如「红烧肉」" },
      "id": { "type": "string", "description": "detail 时的菜谱 ID（来自 rank / search 返回）" },
      "page": { "type": "integer", "description": "页码，默认 1" }
    },
    "required": ["type"]
  },
  "ui": {
    "type": { "source": "ui", "widget": "select" },
    "keyword": { "source": "ui", "widget": "input" },
    "id": { "source": "ui", "widget": "input" }
  },
  "tags": { "domain": "net", "action": "read", "scene": "daily" },
  "compliance": { "risk": "low", "note": "免费接口" },
  "store": { "quota_mb": 1, "secret": true }
}
