{
  "name": "download_url",
  "version": "1.0.1",
  "description": "后台下载任意文件，实时显示进度并返回保存路径",
  "author": "khatkit",
  "license": "MIT",
  "engine": "js",
  "entry": { "js": "main.js" },
  "privilege": "none",
  "requires": {
    "bridges": ["download", "ui", "store"],
    "libs": [],
    "bins": [],
    "env": []
  },
  "network": { "allow": [] },
  "parameters": {
    "type": "object",
    "properties": {
      "url": { "type": "string", "description": "文件下载地址" },
      "name": { "type": "string", "description": "保存文件名，留空按 URL 推断" }
    },
    "required": ["url"]
  },
  "ui": {
    "url": { "source": "ui", "widget": "input" },
    "name": { "source": "ui", "widget": "input" }
  },
  "tags": { "domain": "net", "action": "create", "scene": "daily" },
  "compliance": { "risk": "low", "note": "" },
  "store": { "quota_mb": 5, "secret": false }
}
