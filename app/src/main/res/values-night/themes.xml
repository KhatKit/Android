<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="Theme.KhatKit" parent="android:Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/splash_background</item>
    <!-- 系统启动页（API 31+）。退场后由 feature/splash 的 Compose 覆盖层接力完成品牌动画与揭幕。 -->
    <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_background</item>
    <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_animated_icon</item>
    <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">1000</item>
  </style>
</resources>
