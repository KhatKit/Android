{
  "name": "zenneko_chineseconverter",
  "version": "1.0.0",
  "description": "简繁转换：简体中文与繁体中文互转，支持批量文本（免费）",
  "author": "khatkit",
  "license": "MIT",
  "engine": "lua",
  "entry": { "lua": "main.lua" },
  "privilege": "none",
  "requires": {
    "bridges": ["tool", "ui", "store"],
    "libs": [],
    "bins": [],
    "env": []
  },
  "network": { "allow": ["zenneko.top"] },
  "parameters": {
    "type": "object",
    "properties": {
      "data": { "type": "string", "description": "待转换的文本内容" },
      "type": { "type": "string", "enum": ["s2t", "t2s"], "description": "转换方向：s2t（简体→繁体）/ t2s（繁体→简体），兼容 1/2" }
    },
    "required": ["data", "type"]
  },
  "ui": {
    "data": { "source": "ui", "widget": "input" },
    "type": { "source": "ui", "widget": "select" }
  },
  "tags": { "domain": "text", "action": "convert", "scene": "work" },
  "compliance": { "risk": "low", "note": "免费接口" },
  "store": { "quota_mb": 1, "secret": true }
}
