{
  "name": "zenneko_upscale",
  "version": "1.0.0",
  "description": "图像放大：AI 超分辨率放大图片（默认 2x），返回结果图片链接（成功扣费 ¥0.02/次）",
  "author": "khatkit",
  "license": "MIT",
  "engine": "lua",
  "entry": { "lua": "main.lua" },
  "privilege": "none",
  "requires": {
    "bridges": ["tool", "ui", "store"],
    "libs": [],
    "bins": [],
    "env": []
  },
  "network": { "allow": ["zenneko.top"] },
  "parameters": {
    "type": "object",
    "properties": {
      "image": { "type": "string", "description": "本地图片路径（也可直接传 data URL / base64）" },
      "scale": { "type": "integer", "description": "放大倍数，默认 2" }
    },
    "required": ["image"]
  },
  "ui": {
    "image": { "source": "ui", "widget": "file_picker" },
    "scale": { "source": "ui", "widget": "number" }
  },
  "tags": { "domain": "media", "action": "convert", "scene": "daily" },
  "compliance": { "risk": "medium", "note": "付费接口：成功调用扣费 ¥0.02/次（失败不扣费）；请确保拥有图片使用授权" },
  "store": { "quota_mb": 1, "secret": true }
}
