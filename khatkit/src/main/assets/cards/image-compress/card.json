{
  "name": "image_compress",
  "version": "1.0.0",
  "description": "批量压缩图片体积（JS 示例卡片）",
  "author": "khatkit",
  "license": "MIT",
  "engine": "js",
  "entry": { "js": "main.js" },
  "privilege": "none",
  "requires": {
    "bridges": ["tool", "ui"],
    "libs": [],
    "bins": [],
    "env": []
  },
  "network": { "allow": [] },
  "parameters": {
    "type": "object",
    "properties": {
      "files": {
        "type": "array",
        "items": { "type": "string" },
        "description": "待压缩的图片路径"
      },
      "quality": {
        "type": "integer",
        "minimum": 10,
        "maximum": 100,
        "description": "JPEG 质量"
      }
    },
    "required": ["files"]
  },
  "ui": {
    "files": { "source": "ui", "widget": "file_picker", "filter": "image/*" },
    "quality": { "source": "ui", "widget": "slider", "min": 10, "max": 100 }
  },
  "tags": { "domain": "media", "action": "batch", "scene": "daily" },
  "compliance": { "risk": "low", "note": "" },
  "store": { "quota_mb": 20, "secret": false }
}
